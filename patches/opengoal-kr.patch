+/*!
+ * og:kr Jak 1 Korean. Hangul syllables become <lead><glyph> byte pairs from the charmap,
+ * everything else goes through the normal encoding. A syllable missing from the charmap
+ * is an error: the font must be regenerated to include it.
+ */
+std::string GameTextFontBank::convert_utf8_to_game_korean_jak1(
+    const std::string& str,
+    const Jak1KoreanCharmap& charmap) const {
+  std::string output;
+  std::string non_korean;
+  size_t i = 0;
+  while (i < str.size()) {
+    const size_t start = i;
+    const char32_t cp = str_util::next_utf8_char(str, i);
+    if (cp < 0xAC00 || cp > 0xD7A3) {
+      non_korean.append(str, start, i - start);
+      continue;
+    }
+    const auto syllable = str.substr(start, i - start);
+    const auto it = charmap.find(syllable);
+    if (it == charmap.end()) {
+      throw std::runtime_error(
+          fmt::format("Korean syllable '{}' is not in the Jak 1 font charmap: {}", syllable, str));
+    }
+    output += convert_utf8_to_game(non_korean);
+    non_korean.clear();
+    output.push_back(static_cast<char>(it->second.first));
+    output.push_back(static_cast<char>(it->second.second));
+  }
+  return output + convert_utf8_to_game(non_korean);
+}
+
+Jak1KoreanCharmap load_jak1_korean_charmap(const std::string& path) {
+  Jak1KoreanCharmap charmap;
+  const auto json = parse_commented_json(file_util::read_text_file(path), path);
+  for (auto it = json.begin(); it != json.end(); ++it) {
+    charmap[it.key()] = {it.value().at(0).get<u8>(), it.value().at(1).get<u8>()};
+  }
+  return charmap;
+}
+
+namespace {
+const Jak1KoreanCharmap& cached_jak1_charmap(std::optional<Jak1KoreanCharmap>& cache,
+                                             const std::string& name) {
+  if (!cache.has_value()) {
+    cache = load_jak1_korean_charmap(
+        file_util::get_file_path({"game/assets/fonts", "jak1_korean_charmap_" + name + ".json"}));
+  }
+  return *cache;
+}
+}  // namespace
+
+std::string GameTextFontBank::convert_utf8_to_game_korean_subtitle(const std::string& str) {
+  if (m_version == GameTextVersion::JAK1_V2) {
+    return convert_utf8_to_game_korean_jak1(
+        str, cached_jak1_charmap(m_jak1_korean_charmap_subtitle, "subtitle"));
+  }
+  return convert_utf8_to_game_korean(str);
+}
+
 std::string GameTextFontBank::convert_utf8_to_game_korean(const std::string& str) {
+  if (m_version == GameTextVersion::JAK1_V2) {
+    return convert_utf8_to_game_korean_jak1(str,
+                                            cached_jak1_charmap(m_jak1_korean_charmap_menu, "menu"));
+  }
   ASSERT_MSG(m_version == GameTextVersion::JAK2 || m_version == GameTextVersion::JAK3,
              "Korean is not supported for any game other than Jak 2 and Jak 3 right now");
   if (!m_korean_db.has_value()) {
