diff --git a/test/test_font_korean_jak1.cpp b/test/test_font_korean_jak1.cpp
new file mode 100644
index 00000000..63271588
--- /dev/null
+++ b/test/test_font_korean_jak1.cpp
@@ -0,0 +1,45 @@
+// og:kr Jak 1 Korean text encoding (AI-assisted)
+#include "common/util/FileUtil.h"
+#include "common/util/font/font_utils.h"
+
+#include "gtest/gtest.h"
+
+namespace {
+Jak1KoreanCharmap test_map() {
+  return {{"가", {2, 0x21}}, {"나", {2, 0xa1}}};
+}
+}  // namespace
+
+TEST(FontKoreanJak1, LanguageIdSeventeenIsKorean) {
+  auto* bank = get_font_bank(GameTextVersion::JAK1_V2);
+  EXPECT_TRUE(bank->is_language_id_korean(17));
+  EXPECT_FALSE(bank->is_language_id_korean(0));
+  EXPECT_FALSE(bank->is_language_id_korean(6));
+}
+
+TEST(FontKoreanJak1, SyllablesBecomeTwoBytes) {
+  auto* bank = get_font_bank(GameTextVersion::JAK1_V2);
+  EXPECT_EQ(bank->convert_utf8_to_game_korean_jak1("가나", test_map()), "\x02\x21\x02\xa1");
+}
+
+TEST(FontKoreanJak1, NonKoreanRunsUseNormalEncoding) {
+  auto* bank = get_font_bank(GameTextVersion::JAK1_V2);
+  const std::string tail = " <PAD_X> 1";
+  EXPECT_EQ(bank->convert_utf8_to_game_korean_jak1("가" + tail, test_map()),
+            "\x02\x21" + bank->convert_utf8_to_game(tail));
+}
+
+TEST(FontKoreanJak1, MissingSyllableFailsTheBuild) {
+  auto* bank = get_font_bank(GameTextVersion::JAK1_V2);
+  EXPECT_THROW(bank->convert_utf8_to_game_korean_jak1("다", test_map()), std::runtime_error);
+}
+
+TEST(FontKoreanJak1, LoadsCharmapFile) {
+  const auto path = file_util::get_jak_project_dir() / "test_kr_charmap.tmp.json";
+  file_util::write_text_file(path, "{\"\xea\xb0\x80\": [2, 33], \"\xeb\x82\x98\": [4, 161]}");
+  const auto map = load_jak1_korean_charmap(path.string());
+  fs::remove(path);
+  ASSERT_EQ(map.size(), 2u);
+  EXPECT_EQ(map.at("가"), std::make_pair(u8(2), u8(33)));
+  EXPECT_EQ(map.at("나"), std::make_pair(u8(4), u8(161)));
+}
