new file mode 100644
index 00000000..4dd4e081
--- /dev/null
+++ b/goal_src/jak1/pc/kr-font.gc
@@ -0,0 +1,37 @@
+;;-*-Lisp-*-
+(in-package goal)
+
+;; og:kr Korean font support.
+;; The gamefontnew sheets are replaced by larger textures (custom_assets texture_replacements)
+;; that keep the original glyphs, upscaled, in the top-left corner. Here we rescale the
+;; original font table UVs and glyph UV size to that corner, and extend the tables with the
+;; Korean code pages generated in kr-font-data.gc.
+
+(defun kr-font-extend-table ((old (inline-array vector)) (old-len int))
+  "Return a new font table of *kr-font-table-length* entries: rescaled originals + Korean."
+  (let ((tbl (the-as (inline-array vector) (malloc 'global (* 16 *kr-font-table-length*)))))
+    (dotimes (i *kr-font-table-length*)
+      (set-vector! (-> tbl i) 0.0 0.0 1.0 24.0))
+    (dotimes (i old-len)
+      (set-vector! (-> tbl i)
+                   (* (-> old i x) *kr-font-uv-scale-x*)
+                   (* (-> old i y) *kr-font-uv-scale-y*)
+                   (-> old i z)
+                   (-> old i w)))
+    (dotimes (k (-> *kr-font-entry-index* length))
+      (let ((v (-> tbl (-> *kr-font-entry-index* k))))
+        (set! (-> v x) (-> *kr-font-entry-uv* (* 2 k)))
+        (set! (-> v y) (-> *kr-font-entry-uv* (+ (* 2 k) 1)))))
+    tbl))
+
+(defun kr-font-install ()
+  (set! *font24-table* (kr-font-extend-table *font24-table* 289))
+  (set! *font12-table* (kr-font-extend-table *font12-table* 250))
+  (let ((fw *font-work*))
+    (*! (-> fw size-st1 x) *kr-font-uv-scale-x*)
+    (*! (-> fw size-st2 y) *kr-font-uv-scale-y*)
+    (*! (-> fw size-st3 x) *kr-font-uv-scale-x*)
+    (*! (-> fw size-st3 y) *kr-font-uv-scale-y*))
+  0)
+
+(kr-font-install)
