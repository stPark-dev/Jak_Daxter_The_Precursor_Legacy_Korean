[
 {
  "id": "cut:minershort-introduction-gnawers:0",
  "src": "WHY DON'T YOU TWO MAKE YOURSELVES USEFUL?",
  "speaker": "GORDY",
  "ko": "",
  "state": "untranslated",
  "note": ""
 },
 {
  "id": "cut:minershort-introduction-gnawers:1",
  "src": "LURKERS HAVE BEEN EXCAVATIN' THE DARK CAVES OVER THERE.",
  "speaker": "GORDY",
  "ko": "",
  "state": "untranslated",
  "note": ""
 },
 {
  "id": "cut:minershort-introduction-gnawers:2",
  "src": "SEEMS THEY'RE LOOKIN' FOR PRECURSOR ARTIFACTS.",
  "speaker": "GORDY",
  "ko": "",
  "state": "untranslated",
  "note": ""
 },
 {
  "id": "cut:minershort-introduction-gnawers:3",
  "src": "THEY CAN HAVE THE ARTIFACTS, FOR ALL I CARE.",
  "speaker": "GORDY",
  "ko": "",
  "state": "untranslated",
  "note": ""
 },
 {
  "id": "cut:minershort-introduction-gnawers:4",
  "src": "FOR ALL WE CARE!",
  "speaker": "WILLARD",
  "ko": "",
  "state": "untranslated",
  "note": ""
 },
 {
  "id": "cut:minershort-introduction-gnawers:5",
  "src": "WILLARD, FEED YOUR BIRD.",
  "speaker": "GORDY",
  "ko": "",
  "state": "untranslated",
  "note": ""
 },
 {
  "id": "cut:minershort-introduction-gnawers:6",
  "src": "ALL I CARE ABOUT ARE GEMS!",
  "speaker": "GORDY",
  "ko": "",
  "state": "untranslated",
  "note": ""
 },
 {
  "id": "cut:minershort-introduction-gnawers:7",
  "src": "BUT I AIN'T GONNA BE ABLE TO GET THE CAVE'S GEMS",
  "speaker": "GORDY",
  "ko": "",
  "state": "untranslated",
  "note": ""
 },
 {
  "id": "cut:minershort-introduction-gnawers:8",
  "src": "BECAUSE WHEN THEY'RE THROUGH, THEY'RE GONNA COLLAPSE THE PLACE!",
  "speaker": "GORDY",
  "ko": "",
  "state": "untranslated",
  "note": ""
 },
 {
  "id": "cut:minershort-introduction-gnawers:9",
  "src": "IF YOU TAKE OUT THE LURKERS CHEWIN' AT THE SUPPORT BEAMS,",
  "speaker": "GORDY",
  "ko": "",
  "state": "untranslated",
  "note": ""
 },
 {
  "id": "cut:minershort-introduction-gnawers:10",
  "src": "YOU COULD SAVE THE CAVE FOR ME.",
  "speaker": "GORDY",
  "ko": "",
  "state": "untranslated",
  "note": ""
 },
 {
  "id": "cut:minershort-introduction-gnawers:11",
  "src": "NOW BEAT IT!",
  "speaker": "GORDY",
  "ko": "",
  "state": "untranslated",
  "note": ""
 }
]
