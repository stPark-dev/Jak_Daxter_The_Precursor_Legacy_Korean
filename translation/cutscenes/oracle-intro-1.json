[
 {
  "id": "cut:oracle-intro-1:0",
  "src": "WHO AWAKENS THE ORACLE?",
  "speaker": "ORACLE",
  "ko": "",
  "state": "untranslated",
  "note": ""
 },
 {
  "id": "cut:oracle-intro-1:1",
  "src": "WAIT, ONE OF YOU HAS THE LIGHT WITHIN.",
  "speaker": "ORACLE",
  "ko": "",
  "state": "untranslated",
  "note": ""
 },
 {
  "id": "cut:oracle-intro-1:2",
  "src": "FROM BEFORE TIME, I HAVE WATCHED AND WAITED",
  "speaker": "ORACLE",
  "ko": "",
  "state": "untranslated",
  "note": ""
 },
 {
  "id": "cut:oracle-intro-1:3",
  "src": "FOR THE TRUE HERO TO RETURN.",
  "speaker": "ORACLE",
  "ko": "",
  "state": "untranslated",
  "note": ""
 },
 {
  "id": "cut:oracle-intro-1:4",
  "src": "PRESENT TO ME 120 PRECURSOR ORBS",
  "speaker": "ORACLE",
  "ko": "",
  "state": "untranslated",
  "note": ""
 },
 {
  "id": "cut:oracle-intro-1:5",
  "src": "FOR EACH POWER CELL I CONTAIN.",
  "speaker": "ORACLE",
  "ko": "",
  "state": "untranslated",
  "note": ""
 }
]
