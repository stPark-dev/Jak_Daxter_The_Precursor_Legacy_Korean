[
 {
  "id": "cut:sage-bluehut-introduction-crop-dusting:0",
  "src": "WELL, THE SITUATION HERE STINKS WORSE THAN A LURKER'S ARMPIT.",
  "speaker": "SAMOS",
  "ko": "",
  "state": "untranslated",
  "note": ""
 },
 {
  "id": "cut:sage-bluehut-introduction-crop-dusting:1",
  "src": "BEFORE BLUE SAGE'S DISAPPEARANCE,",
  "speaker": "SAMOS",
  "ko": "",
  "state": "untranslated",
  "note": ""
 },
 {
  "id": "cut:sage-bluehut-introduction-crop-dusting:2",
  "src": "HE JOURNALED SIGNIFICANT TROUBLE IN ALL OF THE SURROUNDING AREAS.",
  "speaker": "SAMOS",
  "ko": "",
  "state": "untranslated",
  "note": ""
 },
 {
  "id": "cut:sage-bluehut-introduction-crop-dusting:3",
  "src": "OF PARTICULAR INTEREST TO ME IS THE DARK ECO INFECTION",
  "speaker": "SAMOS",
  "ko": "",
  "state": "untranslated",
  "note": ""
 },
 {
  "id": "cut:sage-bluehut-introduction-crop-dusting:4",
  "src": "OF SOME INNOCENT PLANTS IN THE PRECURSOR BASIN.",
  "speaker": "SAMOS",
  "ko": "",
  "state": "untranslated",
  "note": ""
 },
 {
  "id": "cut:sage-bluehut-introduction-crop-dusting:5",
  "src": "KEIRA WILL TELEPORT YOUR A-GRAV ZOOMER TO THE NEAREST TRANS-PAD.",
  "speaker": "SAMOS",
  "ko": "",
  "state": "untranslated",
  "note": ""
 },
 {
  "id": "cut:sage-bluehut-introduction-crop-dusting:6",
  "src": "RIDE THE ZOOMER TO A GREEN ECO VENT,",
  "speaker": "SAMOS",
  "ko": "",
  "state": "untranslated",
  "note": ""
 },
 {
  "id": "cut:sage-bluehut-introduction-crop-dusting:7",
  "src": "AND THEN CARRY THE GREEN ECO TO THE CORRUPTED PLANTS.",
  "speaker": "SAMOS",
  "ko": "",
  "state": "untranslated",
  "note": ""
 },
 {
  "id": "cut:sage-bluehut-introduction-crop-dusting:8",
  "src": "THAT SHOULD HEAL THEM.",
  "speaker": "SAMOS",
  "ko": "",
  "state": "untranslated",
  "note": ""
 },
 {
  "id": "cut:sage-bluehut-introduction-crop-dusting:9",
  "src": "DON'T MISS A SINGLE PLANT, OR THE INFECTED ONES WILL SLOWLY RE-INFECT THE HEALTHY ONES.",
  "speaker": "SAMOS",
  "ko": "",
  "state": "untranslated",
  "note": ""
 },
 {
  "id": "cut:sage-bluehut-introduction-crop-dusting:10",
  "src": "AND, DAXTER...",
  "speaker": "SAMOS",
  "ko": "",
  "state": "untranslated",
  "note": ""
 },
 {
  "id": "cut:sage-bluehut-introduction-crop-dusting:11",
  "src": "START CLEANING UP IN HERE!",
  "speaker": "SAMOS",
  "ko": "",
  "state": "untranslated",
  "note": ""
 },
 {
  "id": "cut:sage-bluehut-introduction-crop-dusting:12",
  "src": "AND DON'T FORGET THE CORNERS!",
  "speaker": "SAMOS",
  "ko": "",
  "state": "untranslated",
  "note": ""
 }
]
