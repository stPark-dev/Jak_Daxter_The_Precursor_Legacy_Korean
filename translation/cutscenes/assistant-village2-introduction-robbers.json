  "note": ""
 },
 {
  "id": "cut:assistant-village2-introduction-robbers:6",
  "src": "UNTIL YOU FIND THE ONE WITH THE POWER CELL.",
  "speaker": "KEIRA",
  "ko": "",
  "state": "untranslated",
  "note": ""
 },
 {
  "id": "cut:assistant-village2-introduction-robbers:7",
  "src": "YOU'LL FIND THE ZOOMER ON THE TRANS-PAD NEAR THE ENTRANCE TO THE PRECURSOR BASIN.",
  "speaker": "KEIRA",
