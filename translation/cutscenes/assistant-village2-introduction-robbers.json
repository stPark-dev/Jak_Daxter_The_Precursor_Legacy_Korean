  "ko": "",
  "state": "untranslated",
  "note": ""
 },
 {
  "id": "cut:assistant-village2-introduction-robbers:2",
  "src": "ACCORDING TO HIS NOTES,",
  "speaker": "KEIRA",
  "ko": "",
  "state": "untranslated",
  "note": ""
 },
 {
  "id": "cut:assistant-village2-introduction-robbers:3",
  "src": "A COUPLE OF DAYS AGO FLYING LURKERS STOLE ONE FROM THE BLUE SAGE,",
  "speaker": "KEIRA",
  "ko": "",
  "state": "untranslated",
  "note": ""
 },
 {
  "id": "cut:assistant-village2-introduction-robbers:4",
  "src": "AND FLEW OFF INTO THE PRECURSOR BASIN.",
  "speaker": "KEIRA",
  "ko": "",
  "state": "untranslated",
  "note": ""
 },
 {
  "id": "cut:assistant-village2-introduction-robbers:5",
  "src": "I'LL BET YOU COULD RUN THOSE LURKERS DOWN WITH YOUR ZOOMER",
