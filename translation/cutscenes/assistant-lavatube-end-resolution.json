[
 {
  "id": "cut:assistant-lavatube-end-resolution:0",
  "src": "HEY! WHERE'S OL' SHORT, GREEN AND WRINKLY?",
  "speaker": "DAXTER",
  "ko": "",
  "state": "untranslated",
  "note": ""
 },
 {
  "id": "cut:assistant-lavatube-end-resolution:1",
  "src": "THIS IS TERRIBLE! FATHER IS MISSING!",
  "speaker": "KEIRA",
  "ko": "",
  "state": "untranslated",
  "note": ""
 },
 {
  "id": "cut:assistant-lavatube-end-resolution:2",
  "src": "I THINK GOL AND MAIA MAY HAVE KIDNAPPED HIM AS WELL!",
  "speaker": "KEIRA",
  "ko": "",
  "state": "untranslated",
  "note": ""
 },
 {
  "id": "cut:assistant-lavatube-end-resolution:3",
  "src": "RELAX, SWEETHEART. I GOT EVERYTHING UNDER CONTROL.",
  "speaker": "DAXTER",
  "ko": "",
  "state": "untranslated",
  "note": ""
 },
 {
  "id": "cut:assistant-lavatube-end-resolution:4",
  "src": "UNDER CONTROL?!",
  "speaker": "KEIRA",
  "ko": "",
  "state": "untranslated",
  "note": ""
 },
 {
  "id": "cut:assistant-lavatube-end-resolution:5",
  "src": "LURKER ARMIES CONTINUE TO GROW ACROSS THE LAND,",
  "speaker": "KEIRA",
  "ko": "",
  "state": "untranslated",
  "note": ""
 },
 {
  "id": "cut:assistant-lavatube-end-resolution:6",
  "src": "THE SAGES HAVE BEEN KIDNAPPED,",
  "speaker": "KEIRA",
  "ko": "",
  "state": "untranslated",
  "note": ""
 },
 {
  "id": "cut:assistant-lavatube-end-resolution:7",
  "src": "GOL AND MAIA HAVE GATHERED ENOUGH ECO",
  "speaker": "KEIRA",
  "ko": "",
  "state": "untranslated",
  "note": ""
 },
 {
  "id": "cut:assistant-lavatube-end-resolution:8",
  "src": "TO COMPLETE THEIR TERRIBLE PLAN,",
  "speaker": "KEIRA",
  "ko": "",
  "state": "untranslated",
  "note": ""
 },
 {
  "id": "cut:assistant-lavatube-end-resolution:9",
  "src": "AND TO STOP THEM, YOU'RE GOING TO HAVE TO",
  "speaker": "KEIRA",
  "ko": "",
  "state": "untranslated",
  "note": ""
 },
 {
  "id": "cut:assistant-lavatube-end-resolution:10",
  "src": "FIGHT YOUR WAY THROUGH THEIR CITADEL!",
  "speaker": "KEIRA",
  "ko": "",
  "state": "untranslated",
  "note": ""
 },
 {
  "id": "cut:assistant-lavatube-end-resolution:11",
  "src": "UH... YEAH. THAT ABOUT, UH... SUMS IT UP.",
  "speaker": "DAXTER",
  "ko": "",
  "state": "untranslated",
  "note": ""
 },
 {
  "id": "cut:assistant-lavatube-end-resolution:12",
  "src": "YOU'VE GOT TO RESCUE MY FATHER BEFORE IT'S TOO LATE!",
  "speaker": "KEIRA",
  "ko": "",
  "state": "untranslated",
  "note": ""
 },
 {
  "id": "cut:assistant-lavatube-end-resolution:13",
  "src": "AND JAK...",
  "speaker": "KEIRA",
  "ko": "",
  "state": "untranslated",
  "note": ""
 },
 {
  "id": "cut:assistant-lavatube-end-resolution:14",
  "src": "BE CAREFUL.",
  "speaker": "KEIRA",
  "ko": "",
  "state": "untranslated",
  "note": ""
 },
 {
  "id": "cut:assistant-lavatube-end-resolution:15",
