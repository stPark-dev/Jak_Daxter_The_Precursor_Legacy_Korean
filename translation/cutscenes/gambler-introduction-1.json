[
 {
  "id": "cut:gambler-introduction-1:0",
  "src": "AW, NO. NOT ANOTHER \"HERO\".",
  "speaker": "GAMBLER",
  "ko": "",
  "state": "untranslated",
  "note": ""
 },
 {
  "id": "cut:gambler-introduction-1:1",
  "src": "I LOST MY SHORTS ON THIS SO-CALLED HERO'S BIG FIGHT",
  "speaker": "GAMBLER",
  "ko": "",
  "state": "untranslated",
  "note": ""
 },
 {
  "id": "cut:gambler-introduction-1:2",
  "src": "AGAINST THE MONSTER UP THERE.",
  "speaker": "GAMBLER",
  "ko": "",
  "state": "untranslated",
  "note": ""
 },
 {
  "id": "cut:gambler-introduction-1:3",
  "src": "TRUST ME, THE SMART MONEY'S ON THE MONSTER.",
  "speaker": "GAMBLER",
  "ko": "",
  "state": "untranslated",
  "note": ""
 },
 {
  "id": "cut:gambler-introduction-1:4",
  "src": "THAT WAGER PRETTY MUCH TAPPED ME OUT!",
  "speaker": "GAMBLER",
  "ko": "",
  "state": "untranslated",
  "note": ""
 },
 {
  "id": "cut:gambler-introduction-1:5",
  "src": "SO'S, I GOT A PROPOSAL.",
  "speaker": "GAMBLER",
  "ko": "",
  "state": "untranslated",
  "note": ""
 },
 {
  "id": "cut:gambler-introduction-1:6",
  "src": "BRING ME 90 ORBS TO GET ME BACK ON MY FEET AND OUT OF THIS BARREL,",
  "speaker": "GAMBLER",
  "ko": "",
  "state": "untranslated",
  "note": ""
 },
 {
  "id": "cut:gambler-introduction-1:7",
  "src": "AND I'LL GIVE YOU A POWER CELL IN RETURN.",
  "speaker": "GAMBLER",
  "ko": "",
  "state": "untranslated",
  "note": ""
 },
 {
  "id": "cut:gambler-introduction-1:8",
  "src": "AND IF YOU'RE GAME, I DO HAVE ONE MORE BET ONLINE.",
  "speaker": "GAMBLER",
  "ko": "",
  "state": "untranslated",
  "note": ""
 },
 {
  "id": "cut:gambler-introduction-1:9",
  "src": "MY BIG COMEBACK!",
  "speaker": "GAMBLER",
  "ko": "",
  "state": "untranslated",
  "note": ""
 },
 {
  "id": "cut:gambler-introduction-1:10",
  "src": "BEAT THE RECORD TIME RACING DEAD MAN'S GORGE IN THE PRECURSOR BASIN,",
  "speaker": "GAMBLER",
  "ko": "",
  "state": "untranslated",
  "note": ""
 },
 {
  "id": "cut:gambler-introduction-1:11",
  "src": "AND I'LL GET A PRETTY PAYOFF!",
  "speaker": "GAMBLER",
  "ko": "",
  "state": "untranslated",
  "note": ""
 },
 {
  "id": "cut:gambler-introduction-1:12",
  "src": "FOR THAT, I'LL GIVE YOU ANOTHER POWER CELL.",
  "speaker": "GAMBLER",
  "ko": "",
  "state": "untranslated",
  "note": ""
 }
]
